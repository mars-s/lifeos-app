<Frame>
<style>
.board { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; width: min(100%, 240px); margin: 0 auto; }
.board button { height: 5rem; font-size: 2rem; }
.msg { text-align: center; color: var(--dim); }
</style>
<h3>Noughts and crosses</h3>
<p class="msg" id="msg"></p>
<div class="board" id="board">
<button></button>
<button></button>
<button></button>
<button></button>
<button></button>
<button></button>
<button></button>
<button></button>
<button></button>
</div>
<p><button onclick="reset()">New game</button></p>
<script>
const cells = [...document.querySelectorAll("#board button")]
const msg = document.getElementById("msg")
const lines = [[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]]
let board, turn, over

const say = text => { msg.textContent = text }
const winner = () => lines.find(([a, b, c]) => board[a] && board[a] === board[b] && board[a] === board[c])

function reset() {
  board = Array(9).fill("")
  turn = "X"
  over = false
  cells.forEach(c => { c.textContent = "" })
  say("X to play")
}

cells.forEach((cell, i) => cell.onclick = () => {
  if (over || board[i]) return
  board[i] = turn
  cell.textContent = turn
  ui.haptic("snap")
  if (winner()) {
    over = true
    say(turn + " wins")
    ui.haptic("complete")
  } else if (board.every(Boolean)) {
    over = true
    say("Draw")
  } else {
    turn = turn === "X" ? "O" : "X"
    say(turn + " to play")
  }
})

reset()
</script>
</Frame>
