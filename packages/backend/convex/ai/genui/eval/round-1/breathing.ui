<Frame>
<style>
.orb{width:40vmin;height:40vmin;max-width:240px;max-height:240px;border-radius:50%;background:var(--track);transform:scale(1);transition:transform 4s ease-in-out}
.orb.grow{transform:scale(1.6)}
.word{font:var(--font);font-size:1.25rem;color:var(--dim);margin:0}
</style>
<div style="display:grid;place-items:center;gap:24px;padding:24px;min-height:100%">
<div id="orb" class="orb"></div>
<p id="word" class="word">in</p>
</div>
<script>
const orb = document.getElementById("orb")
const word = document.getElementById("word")
let growing = true
const breathe = () => {
  orb.classList.toggle("grow", growing)
  word.textContent = growing ? "in" : "out"
  growing = !growing
}
if (ui.reduced) orb.style.transition = "none"
breathe()
setInterval(breathe, 4000)
</script>
</Frame>