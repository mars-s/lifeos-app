<Frame>
<canvas id="pad" style="width:100%;height:180px;touch-action:none;border-radius:12px;background:var(--well);cursor:crosshair"></canvas>
<Row align=end>
<button onclick="clearPad()">Clear</button>
</Row>
<script>
const pad = document.getElementById("pad")
const ctx = pad.getContext("2d")
let drawing = false, last = null

const fit = () => {
  const r = pad.getBoundingClientRect(), d = window.devicePixelRatio || 1
  pad.width = r.width * d
  pad.height = r.height * d
  ctx.setTransform(d, 0, 0, d, 0, 0)
  ctx.lineWidth = 2.5
  ctx.lineCap = "round"
  ctx.lineJoin = "round"
}

const point = e => {
  const r = pad.getBoundingClientRect()
  return [e.clientX - r.left, e.clientY - r.top]
}

pad.onpointerdown = e => {
  drawing = true
  last = point(e)
  ctx.strokeStyle = ui.color("ink")
  pad.setPointerCapture(e.pointerId)
}

pad.onpointermove = e => {
  if (!drawing) return
  const p = point(e)
  ctx.beginPath()
  ctx.moveTo(last[0], last[1])
  ctx.lineTo(p[0], p[1])
  ctx.stroke()
  last = p
}

pad.onpointerup = pad.onpointercancel = () => { drawing = false }

const clearPad = () => {
  const r = pad.getBoundingClientRect()
  ctx.clearRect(0, 0, r.width, r.height)
  ui.haptic("toggle")
}

fit()
window.addEventListener("resize", fit)
</script>
</Frame>
