<Frame>
<style>
.stage { display: grid; place-items: center; padding: 32px 0; perspective: 600px; }
.logo { width: 120px; height: 120px; box-sizing: border-box; border-radius: 28px; border: 6px solid var(--ink); display: grid; place-items: center; transform-style: preserve-3d; animation: spin 12s linear infinite; }
.logo svg { width: 64px; height: 64px; fill: none; stroke: var(--ink); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
@keyframes spin { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }
@media (prefers-reduced-motion: reduce) { .logo { animation: none; } }
</style>
<div class="stage">
<div class="logo">
<svg viewBox="0 0 64 64" aria-label="LifeOS logo"><path d="M18 34 L28 44 L46 22"/></svg>
</div>
</div>
</Frame>