{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@interfere/landmines/configs/recommended.json"
  ],
  "plugins": [
    "typescript",
    "react",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/_generated/**",
    "**/.expo/**",
    "**/src-tauri/target/**",
    "**/src-tauri/gen/**",
    "apps/web/src/components/ui/**",
    "apps/web/src/lib/utils.ts",
    "**/*.gen.ts",
    "apps/mobile/src/components/ui/**",
    "apps/mobile/src/lib/kit.tsx"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/_generated/server"
            ],
            "importNames": [
              "query",
              "mutation",
              "action",
              "httpAction"
            ],
            "message": "Public Convex functions go through ownerQuery, ownerMutation or workerMutation in convex/platform/access.ts, so only the owner or a Worker can call them. See docs/auth.md."
          }
        ],
        "paths": [
          {
            "name": "convex/server",
            "importNames": [
              "queryGeneric",
              "mutationGeneric",
              "actionGeneric",
              "httpActionGeneric"
            ],
            "message": "Public Convex functions go through ownerQuery, ownerMutation or workerMutation in convex/platform/access.ts, so only the owner or a Worker can call them. See docs/auth.md."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "packages/backend/convex/platform/access.ts",
        "packages/backend/convex/http.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
