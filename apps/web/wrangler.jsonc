{
  "$schema": "https://unpkg.com/wrangler@4.166.0/config-schema.json",
  "name": "lifeos-web",
  "account_id": "0237a1806e1ca643d880c719e1c3ec91",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/public",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lifeos.zephyrus.qzz.io", "custom_domain": true }]
}
