{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeOS",
  "version": "0.1.0",
  "identifier": "com.marss.lifeos.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @lifeos/web dev --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @lifeos/web build",
    "frontendDist": "../../web/dist/public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "url": "/",
        "title": "LifeOS",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["lifeos"] }
    }
  }
}
