{
  "name": "lifeos-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:web": "pnpm --filter @lifeos/web dev",
    "dev:mobile": "pnpm --filter @lifeos/mobile start",
    "dev:desktop": "pnpm --filter @lifeos/desktop dev",
    "dev:backend": "pnpm --filter @lifeos/backend dev",
    "lint": "oxlint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @lifeos/web build",
    "build:mobile": "pnpm --filter @lifeos/mobile export:ios",
    "build:desktop": "pnpm --filter @lifeos/desktop build",
    "check": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.0",
    "oxlint": "^1.94.0",
    "typescript": "~6.0.3"
  }
}
